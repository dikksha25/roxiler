# ==========================================================
# Store Rating Application — Environment Configuration
# ==========================================================

# Server Settings
PORT=5000
NODE_ENV=development
API_VERSION=v1

# Frontend Client URL (For CORS Whitelist)
CLIENT_URL=http://localhost:5173

# JWT Authentication
JWT_SECRET=your_production_secure_random_jwt_secret_key_minimum_32_chars
JWT_EXPIRES_IN=7d

# PostgreSQL Database Configuration
PGHOST=localhost
PGPORT=5432
PGDATABASE=store_rating_db
PGUSER=postgres
PGPASSWORD=postgres
PG_SSL=false
PG_MAX_POOL=10
PG_IDLE_TIMEOUT=30000
PG_CONNECT_TIMEOUT=5000

# Security & Rate Limiting
BCRYPT_ROUNDS=10
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
BODY_LIMIT=1mb
